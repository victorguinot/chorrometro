rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function memRef() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signed() && exists(memRef()) && get(memRef()).data.status == 'approved'; }
    function role() { return get(memRef()).data.role; }
    function isOwner() { return isMember() && role() == 'owner'; }
    function canWrite() { return isMember() && (role() == 'owner' || role() == 'colab'); }
    function noOwnerYet() { return !exists(/databases/$(database)/documents/meta/owner); }

    // Solicitudes y miembros: cada uno crea su propia solicitud; solo el organizador aprueba
    match /members/{uid} {
      allow read: if isMember() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid && (
        (request.resource.data.status == 'pending' && !('role' in request.resource.data)) ||
        (noOwnerYet() && request.resource.data.role == 'owner' && request.resource.data.status == 'approved'));
      allow update, delete: if isOwner();
    }
    // El primer usuario que entra puede reclamar ser organizador (una sola vez)
    match /meta/owner {
      allow read: if signed();
      allow create: if signed() && noOwnerYet() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /meta/{doc} {
      allow read: if isMember();
      allow write: if isOwner() && doc != 'owner';
    }
    // Cada miembro puede vincular su propia cuenta a un nombre
    match /accounts/{uid} {
      allow write: if isMember() && request.auth.uid == uid;
    }
    // Notificaciones: cada uno solo ve y cambia las suyas
    match /push/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
    // Qué liadas puede leer cada uno (lo mantiene el servidor): las suyas y las que están en curso
    function accDoc() { return /databases/$(database)/documents/access/$(request.auth.uid); }
    function canSeeSid(sid) { return isOwner() || (isMember() && (!exists(accDoc()) || sid in get(accDoc()).data.sids)); }
    match /access/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }
    // Chorros, actividad y eliminados: solo de las liadas que puede ver cada uno
    // Liadas terminadas: solo el organizador puede tocar sus chorros y personas
    function sessOpen(sid) { return sid is string && exists(/databases/$(database)/documents/sessions/$(sid)) && get(/databases/$(database)/documents/sessions/$(sid)).data.end == null; }
    match /logs/{id} {
      allow read: if canSeeSid(resource.data.sid);
      allow create: if isOwner() || (canWrite() && sessOpen(request.resource.data.sid));
      allow update: if isOwner() || (canWrite() && sessOpen(resource.data.sid) && sessOpen(request.resource.data.sid));
      allow delete: if isOwner() || (canWrite() && sessOpen(resource.data.sid));
    }
    match /people/{id} {
      allow read: if isMember();
      allow create: if isOwner() || (canWrite() && sessOpen(request.resource.data.sid));
      allow update: if isOwner() || (canWrite() && sessOpen(resource.data.sid) && sessOpen(request.resource.data.sid));
      allow delete: if isOwner() || (canWrite() && sessOpen(resource.data.sid));
    }
    match /activity/{id} {
      allow read: if canSeeSid(resource.data.sid);
      allow write: if canWrite();
    }
    match /trash/{id} {
      allow read: if canSeeSid(resource.data.sid);
      allow write: if canWrite();
    }
    // Liadas: solo el organizador cambia el nombre, el horario, la finaliza o la borra
    match /sessions/{id} {
      allow read: if isMember();
      allow create: if canWrite() && request.resource.data.end == null;
      allow update: if isOwner() || (canWrite() && resource.data.end == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rpath', 'locs', 'loc', 'name']));
      allow delete: if isOwner();
    }
    // Datos del Chorrómetro
    match /{col}/{doc} {
      allow read: if isMember() && col != 'members' && col != 'meta' && col != 'push' && col != 'access' && col != 'logs' && col != 'activity' && col != 'trash';
      allow write: if canWrite() && col != 'members' && col != 'meta' && col != 'push' && col != 'sessions' && col != 'people' && col != 'access' && col != 'logs' && col != 'activity' && col != 'trash';
    }
  }
}
